# Copy to .env.local and fill in. Never commit .env.local.
# DevNet only — never mainnet, never real SOL.

SOLANA_RPC_URL=https://api.devnet.solana.com

# Gemini API key from Google AI Studio (PayPerPrompt project).
# Server-side only; sent as the x-goog-api-key header. Leave empty to use
# the labeled deterministic fallback summary.
GEMINI_API_KEY=

# Agent wallet secret key as a JSON array of 64 bytes, e.g. [12,34,...].
# DevNet only. If empty, the server generates an ephemeral wallet per process.
AGENT_WALLET_SECRET=
